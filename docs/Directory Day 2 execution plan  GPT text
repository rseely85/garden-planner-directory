📄 scripts/seedFirestore.js
/**
 * Seed Firestore with suppliers.json and productsCatalog.json
 * Run with: node scripts/seedFirestore.js
 */

import { initializeApp, applicationDefault } from "firebase-admin/app";
import { getFirestore } from "firebase-admin/firestore";
import fs from "fs";
import path from "path";

// Init Firebase Admin using ADC (works with `gcloud auth application-default login`)
initializeApp({ credential: applicationDefault() });
const db = getFirestore();

// Helper to load JSON
function loadJSON(fileName) {
  const filePath = path.resolve(process.cwd(), "data", fileName);
  const raw = fs.readFileSync(filePath, "utf-8");
  return JSON.parse(raw);
}

async function seedSuppliers() {
  const suppliers = loadJSON("suppliers.json");
  console.log(`Seeding ${suppliers.length} suppliers...`);

  for (const supplier of suppliers) {
    const docRef = db.collection("suppliers").doc(supplier.slug);
    await docRef.set({
      ...supplier,
      createdAt: new Date(),
      updatedAt: new Date(),
    });
    console.log(`✅ Seeded supplier: ${supplier.name}`);
  }
}

async function seedProducts() {
  const products = loadJSON("productsCatalog.json");
  console.log(`Seeding ${products.length} products...`);

  for (const product of products) {
    const docRef = db.collection("productsCatalog").doc(product.id);
    await docRef.set({
      ...product,
      createdAt: new Date(),
      updatedAt: new Date(),
    });
    console.log(`✅ Seeded product: ${product.label}`);
  }
}

async function main() {
  try {
    await seedSuppliers();
    await seedProducts();
    console.log("🌱 Firestore seeding complete!");
    process.exit(0);
  } catch (err) {
    console.error("❌ Error seeding Firestore:", err);
    process.exit(1);
  }
}

main();
