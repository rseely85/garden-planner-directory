      <h1 className="text-3xl font-bold">Garden Planner Directory</h1>
      {error && <p style={{ color: "red" }}>Error: {error}</p>}
      {suppliers === null ? (
        <p>Loading suppliers…</p>
      ) : suppliers.length ? (
        <ul>
          {suppliers.map((s) => (
            <li key={s.id}>{s.name}</li>
