    (async () => {
      try {
        const data = await getSuppliers();
        setSuppliers(data);
        console.log("Fetched suppliers:", data);
      } catch (e: any) {
        console.error(e);
        setError(e?.message ?? "Failed to load suppliers");
      }
    })();
  }, []);

