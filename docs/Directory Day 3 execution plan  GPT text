        {supplier.name}
        {supplier.premium && (
          <span className="text-yellow-600 font-medium">Premium ✅</span>
        )}
        {supplier.verified && (
          <span className="text-green-600 font-medium">Verified ✅</span>
        )}
      </h2>

      {supplier.category && (
        <p className="text-gray-500 text-sm">{supplier.category}</p>
      )}

      {supplier.website && (
        <a
          href={supplier.website}
          target="_blank"
          rel="noopener noreferrer"
          className="text-blue-600 underline text-sm block mt-1"
        >
          {supplier.website}
        </a>
      )}

      {supplier.services && supplier.services.length > 0 && (
        <div className="mt-3">
          <h3 className="font-semibold text-sm">Services:</h3>
          <ul className="list-disc list-inside text-sm text-gray-700">
            {supplier.services.map((service, idx) => (
              <li key={idx}>{service}</li>
            ))}
          </ul>
        </div>
      )}

      {supplier.products && supplier.products.length > 0 && (
        <div className="mt-3">
          <h3 className="font-semibold text-sm">Products:</h3>
          <ul className="list-disc list-inside text-sm text-gray-700">
            {supplier.products.map((product, idx) => (
              <li key={idx}>{product}</li>
            ))}
          </ul>
        </div>
      )}
    </div>
  );
}
 
